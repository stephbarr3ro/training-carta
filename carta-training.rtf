\
    <script>\
        const ITEMS = [\
            \{ id: 't1', cat: 'tostada', name: 'POWER AVOCADO',    price: 14000, tag: 'Energ\'eda',       img: 'https://storage.googleapis.com/msgsndr/JF29jtnubhqtdPivD9K0/media/692fc0702b865ee9147df5da.png', desc: 'Masa madre con aguacate fresco.',        ings: ['Masa Madre','Aguacate','Semillas de Ch\'eda'],        nut: \{ cal: 320, pro: 8,  sug: 2,  sod: 180 \} \},\
            \{ id: 't2', cat: 'tostada', name: 'MONKEY FUEL',      price: 14500, tag: 'Prote\'edna',      img: 'https://storage.googleapis.com/msgsndr/JF29jtnubhqtdPivD9K0/media/692fc0707f53113da8fc7c9f.png', desc: 'Alto en prote\'edna y energ\'eda.',           ings: ['Masa Madre','Mantequilla Man\'ed','Banano'],          nut: \{ cal: 450, pro: 14, sug: 12, sod: 220 \} \},\
            \{ id: 't3', cat: 'tostada', name: 'BERRY STRONG',     price: 15500, tag: 'Antioxidantes', img: 'https://storage.googleapis.com/msgsndr/JF29jtnubhqtdPivD9K0/media/692fc0702b865eb6af7df5db.png', desc: 'Explosi\'f3n de sabor fresco.',           ings: ['Masa Madre','Yogurt Griego','Ar\'e1ndanos'],          nut: \{ cal: 380, pro: 12, sug: 18, sod: 150 \} \},\
            \{ id: 't4', cat: 'tostada', name: 'CHOCOFRESA TOAST', price: 14500, tag: 'Recuperaci\'f3n',  img: 'https://storage.googleapis.com/msgsndr/JF29jtnubhqtdPivD9K0/media/692fc07082f4c5b042bfb9f7.png', desc: 'Dulce y reparador.',                   ings: ['Masa Madre','Cacao & Mara\'f1\'f3n','Fresas'],           nut: \{ cal: 410, pro: 10, sug: 15, sod: 160 \} \},\
            \{ id: 'b1', cat: 'bowl',    name: 'BOWL CUMIZ & GRANOLA', price: 13900, tag: 'Digesti\'f3n', img: 'https://www.photo-pick.com/online/api/v1/albums/ad3bf840-27c5-4edd-94e5-aa64427ee152.jpg',        desc: 'Mezcla cremosa con granola.',         ings: ['Cumiz','Granola','Frutas Rojas'],                  nut: \{ cal: 360, pro: 10, sug: 32, sod: 65  \} \}\
        ];\
        const COFFEES = [\{ name:'Tinto',price:3000 \},\{ name:'Americano',price:5000 \},\{ name:'Espresso',price:4000 \},\{ name:'Capuchino',price:8000 \}];\
        const DRINKS  = [\{ name:'RED BULL',price:9000 \},\{ name:'INTENZE LATA',price:9000 \},\{ name:'MONSTER',price:12000 \},\{ name:'C4 LATA',price:15000 \},\{ name:'GATORADE',price:6000 \},\{ name:'HATSU',price:4000 \},\{ name:'AGUA LITRO',price:4000 \},\{ name:'ELECTROLIT',price:10000 \}];\
\
        /* \uc0\u9989  FIX 5: helper \'97 llama createIcons() solo si lucide ya carg\'f3 */\
        function refreshIcons() \{\
            if (typeof lucide !== 'undefined') lucide.createIcons();\
        \}\
\
        function initialize() \{\
            render('tostadas-grid', 'tostada');\
            render('bowls-grid', 'bowl');\
            COFFEES.forEach(c => \{\
                document.getElementById('coffee-list').innerHTML +=\
                    `<div class="flex justify-between items-center border-b border-white/5 pb-4">\
                        <span class="text-xl font-heading font-bold text-white uppercase">$\{c.name\}</span>\
                        <span class="text-2xl font-heading text-brand-red font-bold">$$\{c.price.toLocaleString()\}</span>\
                    </div>`;\
            \});\
            DRINKS.forEach(d => \{\
                document.getElementById('drinks-grid').innerHTML +=\
                    `<div class="bg-zinc-900 p-6 border border-zinc-800 flex justify-between items-center hover:border-brand-red/30 transition-all">\
                        <span class="text-white font-bold uppercase text-[13px] tracking-wide">$\{d.name\}</span>\
                        <span class="text-brand-red font-bold text-lg font-heading">$$\{d.price.toLocaleString()\}</span>\
                    </div>`;\
            \});\
            refreshIcons();\
        \}\
\
        function render(gridId, cat) \{\
            const grid = document.getElementById(gridId);\
            ITEMS.filter(i => i.cat === cat).forEach(item => \{\
                grid.innerHTML += `\
                <div class="bg-zinc-900 border border-zinc-800 flex flex-col md:flex-row overflow-hidden group hover:border-brand-red/30 transition-all duration-300">\
                    <div class="w-full md:w-2/5 h-60 md:h-auto overflow-hidden relative">\
                        <div class="img-placeholder" id="ph-$\{item.id\}"></div>\
                        <img src="$\{item.img\}"\
                             class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 relative z-10"\
                             referrerpolicy="no-referrer"\
                             onload="var p=document.getElementById('ph-$\{item.id\}');if(p)p.style.display='none';"\
                             onerror="this.style.display='none';">\
                        <div class="absolute top-4 left-4 bg-brand-red text-white text-[9px] font-bold px-3 py-1 uppercase tracking-widest z-20">$\{item.tag\}</div>\
                    </div>\
                    <div class="p-8 flex-1 flex flex-col justify-between">\
                        <div>\
                            <div class="flex justify-between items-start mb-3">\
                                <h3 class="text-2xl font-heading font-semibold text-white uppercase tracking-wider">$\{item.name\}</h3>\
                                <span class="text-xl font-heading text-brand-red font-bold">$$\{item.price.toLocaleString()\}</span>\
                            </div>\
                            <p class="text-gray-400 text-sm mb-5 italic line-clamp-2 leading-relaxed">$\{item.desc\}</p>\
                            <ul class="text-[11px] text-gray-300 space-y-1.5 uppercase font-medium">\
                                $\{item.ings.map(ing => `<li class="flex items-center"><div class="w-1 h-1 bg-brand-red rounded-full mr-2 shrink-0"></div>$\{ing\}</li>`).join('')\}\
                            </ul>\
                        </div>\
                        <div class="mt-8 pt-6 border-t border-zinc-800/50 flex justify-end">\
                            <button onclick="showNutrition('$\{item.id\}')" class="flex items-center gap-2 text-[10px] font-bold uppercase tracking-widest text-gray-500 hover:text-brand-red transition-all">\
                                <i data-lucide="activity" class="w-3.5 h-3.5"></i> Ver Nutrici\'f3n\
                            </button>\
                        </div>\
                    </div>\
                </div>`;\
            \});\
        \}\
\
        function switchTab(tabId) \{\
            document.querySelectorAll('#tab-contents > div').forEach(div => div.classList.add('hidden'));\
            document.getElementById('content-' + tabId).classList.remove('hidden');\
            ['snacks','macro','batidos','cafes','bebidas'].forEach(t => \{\
                const btn = document.getElementById('btn-' + t);\
                btn.className = (t === tabId)\
                    ? 'tab-active px-6 md:px-10 py-4 text-lg font-heading tracking-wider uppercase transition-all duration-300 border shadow-lg shadow-brand-red/10'\
                    : 'tab-inactive px-6 md:px-10 py-4 text-lg font-heading tracking-wider uppercase transition-all duration-300 border';\
            \});\
            // \uc0\u9989  FIX 6: Re-inicializa iconos al cambiar tabs (el modal los necesita frescos tambi\'e9n)\
            refreshIcons();\
        \}\
\
        function showNutrition(id) \{\
            const data = id === 'macro'\
                ? \{ name: 'Desayuno Macro', nut: \{ cal: 655, pro: 41, sug: 17, sod: 905 \} \}\
                : ITEMS.find(i => i.id === id);\
            if (!data) return;\
            document.getElementById('modal-title').innerText = data.name;\
            document.getElementById('modal-stats').innerHTML = `\
                <div class="bg-black/50 p-5 border border-zinc-800/80 text-center"><p class="text-[9px] text-gray-500 mb-1">Calor\'edas</p><p class="text-3xl font-heading font-bold text-white">$\{data.nut.cal\}</p></div>\
                <div class="bg-black/50 p-5 border border-zinc-800/80 text-center"><p class="text-[9px] text-gray-500 mb-1">Prote\'edna</p><p class="text-3xl font-heading font-bold text-brand-red">$\{data.nut.pro\}g</p></div>\
                <div class="bg-black/50 p-5 border border-zinc-800/80 text-center"><p class="text-[9px] text-gray-500 mb-1">Az\'facar</p><p class="text-3xl font-heading font-bold text-gray-300">$\{data.nut.sug\}g</p></div>\
                <div class="bg-black/50 p-5 border border-zinc-800/80 text-center"><p class="text-[9px] text-gray-500 mb-1">Sodio</p><p class="text-3xl font-heading font-bold text-gray-300">$\{data.nut.sod\}mg</p></div>`;\
            const modal = document.getElementById('nutrition-modal');\
            modal.classList.remove('hidden');\
            modal.classList.add('flex');\
            // \uc0\u9989  FIX 7: Refrescar el \'edcono X del modal\
            refreshIcons();\
        \}\
\
        function closeNutrition() \{\
            const modal = document.getElementById('nutrition-modal');\
            modal.classList.add('hidden');\
            modal.classList.remove('flex');\
        \}\
\
        function toggleMobileMenu() \{ document.getElementById('mobile-menu').classList.toggle('hidden'); \}\
\
        function scrollToSection(id) \{\
            window.scrollTo(\{ top: document.getElementById(id).offsetTop - 100, behavior: 'smooth' \});\
            document.getElementById('mobile-menu').classList.add('hidden');\
        \}\
\
        window.onload = initialize;\
    </script>\
</body>\
